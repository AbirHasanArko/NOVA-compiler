// TEST: tests/contracts/runtime_bounds_and_div_zero.nova
// KIND: EXPECTED_ERROR
// FLAGS: --interpret
// EXPECT_ERR: runtime error: array index 5 out of bounds (size 3)
// EXIT_CODE: 1

ignite do
    const data: i32[3] = [10, 20, 30];
    flux dyn_idx: i32 = 2;
    dyn_idx = dyn_idx + 3;
    const val: i32 = data[dyn_idx];
    transmit(val);
end
