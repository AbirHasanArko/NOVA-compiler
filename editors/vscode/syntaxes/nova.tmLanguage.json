{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NOVA",
  "scopeName": "source.nova",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#proc-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#telemetry-builtins"
    },
    {
      "include": "#contracts"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#proc-calls"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nova",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nova",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nova",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nova",
          "match": "\\\\(?:[nrt0\\\\\"']|x[0-9a-fA-F]{2})"
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.nova",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.nova",
          "match": "\\\\(?:[nrt0\\\\\"']|x[0-9a-fA-F]{2})"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.nova",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.float.nova",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.nova",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.nova",
          "match": "\\b(i32|f32|bool|char|str|void)\\b"
        }
      ]
    },
    "proc-declaration": {
      "match": "\\b(proc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.nova"
        },
        "2": {
          "name": "entity.name.function.declaration.nova"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.capsule.nova",
          "match": "\\b(ignite)\\b"
        },
        {
          "name": "storage.modifier.state.nova",
          "match": "\\b(const|flux)\\b"
        },
        {
          "name": "keyword.control.block.nova",
          "match": "\\b(do|end)\\b"
        },
        {
          "name": "keyword.control.conditional.nova",
          "match": "\\b(if|elif|else|route|case|default)\\b"
        },
        {
          "name": "keyword.control.loop.nova",
          "match": "\\b(orbit|in|step|cruise)\\b"
        },
        {
          "name": "keyword.control.flow.jump.nova",
          "match": "\\b(halt|skip)\\b"
        },
        {
          "name": "keyword.control.flow.return.nova",
          "match": "\\b(ret)\\b"
        }
      ]
    },
    "telemetry-builtins": {
      "patterns": [
        {
          "name": "support.function.telemetry.nova",
          "match": "\\b(transmit|receive)\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.other.contract.nova",
          "match": "\\b(verify|require)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.nova",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.nova",
          "match": "(\\*\\*|\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.comparison.nova",
          "match": "(<=|>=|==|!=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.nova",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.range.nova",
          "match": "(\\.\\.)"
        },
        {
          "name": "keyword.operator.arrow.nova",
          "match": "(->)"
        }
      ]
    },
    "proc-calls": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.nova"
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.delimiter.nova",
          "match": "[,:;]"
        },
        {
          "name": "punctuation.section.parens.nova",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.nova",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
