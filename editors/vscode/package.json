{
  "name": "nova-language",
  "displayName": "NOVA Language Support",
  "description": "Syntax highlighting, language configuration, and snippets for the NOVA programming language",
  "version": "0.1.0",
  "publisher": "nova-compiler",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nova",
        "aliases": [
          "NOVA",
          "nova"
        ],
        "extensions": [
          ".nova"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nova",
        "scopeName": "source.nova",
        "path": "./syntaxes/nova.tmLanguage.json"
      }
    ]
  }
}
